/* The symbols the original libvoice_en_gb_amy.so exports: the voice entry points the engine
 * looks up after dlopen, the language data and the engine interface version marker. Used by
 * tools/build_runnable.py. */
{
  global:
    register_voice;
    unregister_voice;
    language_data;
    TTS_ENGINE_1_6;
  local:
    *;
};
